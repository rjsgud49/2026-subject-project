PORT=3000
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=p2_lms
NODE_ENV=development
JWT_SECRET=change-this-to-a-long-random-string-in-production
CORS_ORIGIN=http://localhost:5174

# 업로드(영상·첨부) 로컬 디스크 경로 — 비우면 backend/uploads/p2 (서버 cwd 기준)
# Windows 예: P2_UPLOAD_DIR=C:\data\p2-uploads
# P2_UPLOAD_DIR=

# DB 생성: psql -U postgres -c "CREATE DATABASE p2_lms;"

# 온라인 결제 (PG) — 아래 이름 또는 NICEPAY_CLIENT_ID / NICEPAY_SECRET_KEY 도 동일하게 인식
PAYMENT_CLIENT_ID=your_client_id
PAYMENT_SECRET_KEY=your_secret_key
# PG API 베이스 (비우면 NODE_ENV=production → 운영 API, 그 외 → 샌드박스)
# PAYMENT_API_BASE=https://api.nicepay.co.kr
# PG 인증 완료 후 POST 받을 공개 URL (nginx /api 프록시 도메인, /api/v1/payments/return 붙음)
# PAYMENT_RETURN_BASE=https://olp.rjsgud.com

# 이메일 알림 (SMTP 미설정 시 콘솔 로그로 대체)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=authenticationrjsgud49@gmail.com
# SMTP_PASS=wahk ials dlzv goor
# SMTP_FROM=authenticationrjsgud49@gmail.com

# Outbound Webhook 기본 서명(엔드포인트별 secret이 있으면 해당 값 사용)
# P3_WEBHOOK_SIGNING_SECRET=change-me-in-production
