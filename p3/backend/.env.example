PORT=3000
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=p2_lms
NODE_ENV=development
JWT_SECRET=change-this-to-a-long-random-string-in-production
CORS_ORIGIN=http://localhost:5174

# 업로드(영상·첨부) 로컬 디스크 경로 — 비우면 backend/uploads/p2 (서버 cwd 기준)
# Windows 예: P2_UPLOAD_DIR=C:\data\p2-uploads
# P2_UPLOAD_DIR=

# DB 생성: psql -U postgres -c "CREATE DATABASE p2_lms;"

# 나이스페이 샌드박스 (S2 Server 승인 · 실제 과금 없음)
NICEPAY_CLIENT_ID=S2_your_client_id
NICEPAY_SECRET_KEY=your_secret_key
NICEPAY_API_BASE=https://sandbox-api.nicepay.co.kr
# 인증 returnUrl 베이스 (기본: http://127.0.0.1:PORT)
# NICEPAY_RETURN_BASE=http://127.0.0.1:3000

# 이메일 알림 (SMTP 미설정 시 콘솔 로그로 대체)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=authenticationrjsgud49@gmail.com
# SMTP_PASS=wahk ials dlzv goor
# SMTP_FROM=authenticationrjsgud49@gmail.com

# Outbound Webhook 기본 서명(엔드포인트별 secret이 있으면 해당 값 사용)
# P3_WEBHOOK_SIGNING_SECRET=change-me-in-production
